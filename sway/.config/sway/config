# Sway config — ported 1:1 from ~/.config/i3/config
# Same keybinds, colors, borders and window rules. Tuned for speed (no animations).

set $mod Mod4
font pango:Inter 9
floating_modifier $mod normal

set $term alacritty
set $menu rofi -show drun -theme ~/.config/rofi/blue-tone.rasi

# Portals / env for screen sharing, dbus activation etc. (ships with sway)
include /etc/sway/config.d/*

########################################################################
####                   OUTPUT / INPUT
########################################################################

# On Wayland the NVIDIA HDMI port is usually named HDMI-A-1 (check: swaymsg -t get_outputs)
output * mode 1920x1080@60Hz
output * bg ~/walls/DSC00840.jpg fill
# Fallback if the wallpaper is missing:  output * bg #000000 solid_color

# Speed: no extra frame buffering, no adaptive sync surprises
output * adaptive_sync off

input type:keyboard {
    repeat_delay 300
    repeat_rate 40
    # xkb_layout us,ru
    # xkb_options grp:caps_toggle,grp_led:caps
}

focus_follows_mouse yes

########################################################################
####                   KEYBINDS (same as i3)
########################################################################

bindsym $mod+Return exec $term
bindsym $mod+q kill
bindsym $mod+d exec $menu

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+h splith
bindsym $mod+v splitv
bindsym $mod+t splitt

bindsym $mod+f fullscreen toggle

# Screenshots (maim/xclip -> grim/slurp/wl-copy)
bindsym $mod+Shift+s exec grim - | wl-copy -t image/png && notify-send "Screenshot" "Fullscreen copied to clipboard"
bindsym Print exec grim -g "$(slurp)" - | wl-copy -t image/png && notify-send "Screenshot" "Area copied to clipboard"

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+w sticky toggle

bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Sway has no in-place restart; reload covers both
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r reload

bindsym $mod+Shift+e exec ~/.config/rofi/powermenu.sh

mode "resize" {
    bindsym Left resize shrink width 5 px or 5 ppt
    bindsym Down resize grow height 5 px or 5 ppt
    bindsym Up resize shrink height 5 px or 5 ppt
    bindsym Right resize grow width 5 px or 5 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

bindsym $mod+Shift+p exec gnome-calculator
bindsym $mod+l exec swaylock -f

# Volume with on-screen bar (xob -> wob)
set $wob $XDG_RUNTIME_DIR/wob.sock
bindsym XF86AudioRaiseVolume exec pamixer -ui 3 && pamixer --get-volume > $wob
bindsym XF86AudioLowerVolume exec pamixer -ud 3 && pamixer --get-volume > $wob
bindsym XF86AudioMute exec pamixer -t && (pamixer --get-mute | grep -q true && echo 0 || pamixer --get-volume) > $wob
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

########################################################################
####                   LOOK (same Catppuccin colors as i3)
########################################################################

# class                 border  backgr. text    indicator child_border
client.focused          #89b4fa #1e1e2e #ffffff #89b4fa   #89b4fa
client.focused_inactive #45475a #1e1e2e #cccccc #45475a   #45475a
client.unfocused        #313244 #1e1e2e #888888 #313244   #313244
client.urgent           #f38ba8 #f38ba8 #ffffff #f38ba8   #f38ba8
client.placeholder      #000000 #0c0c0c #ffffff #000000   #000000
client.background       #1e1e2e

default_border pixel 1
default_floating_border pixel 1

########################################################################
####                   WINDOW RULES
####  Native Wayland apps match app_id; X11 (XWayland) apps match class.
########################################################################

for_window [title="Calculator"] floating enable
for_window [title="Timer"] floating enable
for_window [app_id="librewolf"] border none
for_window [app_id="firefox"] border none
for_window [class="librewolf"] border none
for_window [class="firefox"] border none
for_window [app_id="mpv"] floating enable
for_window [class="mpv"] floating enable
for_window [app_id="imv"] floating enable
for_window [app_id="zenity"] floating enable
for_window [class="zenity"] floating enable
for_window [app_id="cachyos-hello"] floating enable
for_window [class="cachyos-welcome"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable

########################################################################
####                   AUTOSTART
########################################################################

exec waybar
exec dunst
exec gnome-keyring-daemon --start --components=secrets
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec rm -f $wob && mkfifo $wob && tail -f $wob | wob
exec dex -a -s /etc/xdg/autostart/:~/.config/autostart/
