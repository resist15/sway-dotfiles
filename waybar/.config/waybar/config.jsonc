// Waybar — rebuild of the two polybar bars ("top" and "mybar")
[
  // ───────────────────────── TOP BAR (polybar: top) ─────────────────────────
  {
    "name": "top",
    "layer": "bottom",
    "position": "top",
    "height": 31,
    "spacing": 0,
    "modules-left": ["custom/branding", "sway/window"],
    "modules-right": [
      "custom/bluetooth",
      "custom/music",
      "temperature",
      "custom/gpu",
      "custom/dunst"
    ],

    "custom/branding": {
      "exec": "echo \"$(whoami)@$(cat /etc/hostname)\"",
      "interval": "once",
      "tooltip": false
    },
    "sway/window": {
      "max-length": 60,
      "tooltip": false
    },
    "custom/bluetooth": {
      "exec": "~/.config/waybar/scripts/system-bluetooth-bluetoothctl.sh",
      "interval": 3,
      "on-click": "~/.config/waybar/scripts/system-bluetooth-bluetoothctl.sh --toggle",
      "tooltip": false
    },
    "custom/music": {
      "exec": "~/.config/waybar/scripts/music.sh",
      "interval": 2,
      "on-click": "playerctl play-pause",
      "on-click-right": "playerctl next",
      "on-click-middle": "playerctl previous",
      "on-scroll-up": "playerctl next",
      "on-scroll-down": "playerctl previous",
      "tooltip": false
    },
    "temperature": {
      "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
      "input-filename": "temp1_input",
      "critical-threshold": 80,
      "interval": 5,
      "format": "CPU-TEMP : {temperatureC}°C",
      "tooltip": false
    },
    "custom/gpu": {
      "exec": "~/.config/waybar/scripts/system-nvidia-smi.sh",
      "interval": 2,
      "tooltip": false
    },
    "custom/dunst": {
      "exec": "~/.config/waybar/scripts/dunst.sh",
      "interval": "once",
      "signal": 8,
      "on-click": "dunstctl set-paused toggle; pkill -RTMIN+8 waybar",
      "tooltip": false
    }
  },

  // ─────────────────────── BOTTOM BAR (polybar: mybar) ──────────────────────
  {
    "name": "bottom",
    "layer": "bottom",
    "position": "bottom",
    "height": 31,
    "spacing": 0,
    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-right": ["disk", "pulseaudio", "memory", "cpu", "clock", "tray"],

    "sway/workspaces": {
      "format": "{name}",
      "disable-scroll": false,
      "disable-scroll-wraparound": true,
      "all-outputs": false
    },
    "sway/mode": {
      "format": "{}"
    },
    "disk": {
      "paths": ["/"],
      "interval": 25,
      "format": "<span color='#4BAAC8'> </span>{free}",
      "tooltip": false
    },
    "pulseaudio": {
      "format": "<span color='#4BAAC8'> </span> {volume}%",
      "format-muted": "<span color='#707880'>muted</span>",
      "on-click": "pamixer -t",
      "on-click-right": "pavucontrol",
      "scroll-step": 3,
      "tooltip": false
    },
    "memory": {
      "interval": 2,
      "format": "<span color='#4BAAC8'> </span>{percentage:2}% ({used:0.2f}G/{total:0.2f}G)",
      "tooltip": false
    },
    "cpu": {
      "interval": 2,
      "format": "<span color='#4BAAC8'> </span>{usage:2}%",
      "tooltip": false
    },
    "clock": {
      "interval": 1,
      "format": "{:%a %d %b %I:%M:%S}",
      "tooltip": false
    },
    "tray": {
      "icon-size": 15,
      "spacing": 5
    }
  }
]
