* {
    /* Everforest Colors */
    bg:         #2d353b;
    bg1:        #343f44;
    bg2:        #3d484d;
    bg3:        #475258;
    fg:         #d3c6aa;
    red:        #e67e80;
    orange:     #e69875;
    yellow:     #dbbc7f;
    green:      #a7c080;
    aqua:       #83c092;
    blue:       #7fbbb3;
    purple:     #d699b6;

    background-color:   transparent;
    text-color:         @fg;
}

window {
    background-color:   @bg;
    border:             2px solid;
    border-color:       @green;
    border-radius:      10px;
    width:              500px;
}

mainbox {
    background-color:   transparent;
    padding:            10px;
}

inputbar {
    background-color:   @bg1;
    border-radius:      8px;
    padding:            8px 12px;
    margin:             0 0 10px 0;
    children:           [prompt, entry];
}

prompt {
    text-color:         @green;
    padding:            0 8px 0 0;
}

entry {
    text-color:         @fg;
    placeholder:        "Search...";
    placeholder-color:  @bg3;
}

listview {
    background-color:   transparent;
    lines:              8;
    columns:            1;
    spacing:            4px;
}

element {
    background-color:   transparent;
    border-radius:      6px;
    padding:            8px 12px;
}

element selected {
    background-color:   @bg2;
    text-color:         @green;
}

element-icon {
    size:               24px;
    padding:            0 8px 0 0;
}

element-text {
    text-color:         inherit;
    vertical-align:     0.5;
}
