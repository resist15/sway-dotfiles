#!/bin/sh
# Launch Sway on NVIDIA (GT 1030 / 580xx driver).
# Selected from the login screen (ly) via /usr/share/wayland-sessions/sway-nvidia.desktop

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_DESKTOP=sway

# NVIDIA
export GBM_BACKEND=nvidia-drm
export __GLX_VENDOR_LIBRARY_NAME=nvidia
# Vulkan renderer = explicit sync on NVIDIA -> no flicker/tearing.
# If you get a black screen, comment this line out to fall back to GLES.
export WLR_RENDERER=vulkan
# Fixes invisible/glitchy cursor on NVIDIA. Try removing it later; HW cursor is slightly faster.
export WLR_NO_HARDWARE_CURSORS=1

# Hardware video decode (NVDEC via VA-API). Pin to NVIDIA; the Intel iGPU is also present.
export LIBVA_DRIVER_NAME=nvidia
export NVD_BACKEND=direct
export VDPAU_DRIVER=nvidia
export MOZ_DISABLE_RDD_SANDBOX=1

# Make apps use native Wayland (faster than XWayland)
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=auto
export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME=qt5ct
export _JAVA_AWT_WM_NONREPARENTING=1

exec sway --unsupported-gpu "$@" > "${XDG_RUNTIME_DIR:-/tmp}/sway.log" 2>&1
